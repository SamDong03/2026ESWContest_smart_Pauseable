[Unit]
Description=Pauseable Flutter web application
Wants=network-online.target pauseable-gateway.service
After=network-online.target pauseable-gateway.service
ConditionPathExists=/mnt/c/Pauseable/Pauseable.apps/guardian/build/web/index.html

[Service]
Type=simple
User=dong
Group=dong
WorkingDirectory=/mnt/c/Pauseable/Pauseable.apps/guardian/build/web
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 0.0.0.0 --directory /mnt/c/Pauseable/Pauseable.apps/guardian/build/web
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
