[Unit]
Description=Pauseable Flutter alert Gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dong
Group=dong
WorkingDirectory=/mnt/c/Pauseable/Pauseable.apps/api
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/dong/.venvs/pauseable-gateway/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
