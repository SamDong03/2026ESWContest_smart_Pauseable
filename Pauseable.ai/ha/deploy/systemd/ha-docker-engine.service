[Unit]
Description=Pauseable Docker engine using the existing ATLAS Docker data root
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data /var/lib/docker

[Service]
Type=notify
ExecStart=/usr/bin/dockerd
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=120
KillMode=process
Delegate=yes
LimitNOFILE=1048576
TasksMax=infinity

[Install]
WantedBy=multi-user.target
