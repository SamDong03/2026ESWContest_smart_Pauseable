{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pauseable.local/contracts/voice-request.schema.json",
  "title": "Voice Generation Request",
  "description": "Central App이 GPU 음성 서버에 상황별 가족 음성 생성을 요청하는 메시지입니다.",
  "type": "object",
  "required": ["request_id", "occurred_at", "situation", "message_candidates"],
  "properties": {
    "request_id": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "situation": { "type": "string" },
    "voice_profile_id": { "type": "string" },
    "message_candidates": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
