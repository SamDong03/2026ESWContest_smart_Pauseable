# Docker env-file format. Do not put app/worker tokens here or in GitHub.
# PAUSEABLE_DEVICE_TOKEN is inherited from /var/lib/pauseable/ha.env.
PAUSEABLE_FAVORITE_MUSIC_ENABLED=1
# atlas (existing Pi Chromium) or lg_tv (Render selection -> HA -> LG webOS TV).
PAUSEABLE_MUSIC_BACKEND=atlas
# For lg_tv, HA_URL and HA_TOKEN are inherited from /var/lib/pauseable/ha.env.
# Set these to the actual TV. TV_MAC is required when waking a powered-off TV.
TV_ENTITY=media_player.lg_webos_tv
# TV_MAC=AA:BB:CC:DD:EE:FF
TV_BROADCAST_ADDRESS=255.255.255.255
PAUSEABLE_API_BASE_URL=https://pauseable-api.onrender.com
PATIENT_ID=byunwoojin
# Do not restart the song on every repeated sensor report (seconds).
PAUSEABLE_MUSIC_COOLDOWN_SECONDS=300
