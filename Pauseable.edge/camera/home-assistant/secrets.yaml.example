# Add this entry to Home Assistant's secrets.yaml.
# Update the address whenever DHCP assigns a different address to the Pi 4.
# The text after "Bearer " must match PAUSEABLE_TRIGGER_TOKEN on the Pi 4.
pauseable_camera_trigger_url: "http://PI4_IP:8080/trigger"
pauseable_camera_trigger_authorization: "Bearer replace-with-the-pi4-token"
